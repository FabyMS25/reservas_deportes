	<queryString>
		<![CDATA[SELECT IPC.fecha_asignacion, IPC.fecha_inspeccion, IPC.estado_inspeccion, 
			IPC.url_informe, IPT.nombre, GE.gestion, RU.rubro, DI.distrito, 
			CO.nombre || ' ' || CO.ap_paterno || ' ' || CO.ap_materno AS contribuyente,
			AE.nombre_comercial, AE.direccion
			FROM inspecciones IPC
			INNER JOIN actividades_economicas AE ON AE.id_actividad = IPC.id_actividad
			INNER JOIN contribuyentes CO ON CO.id_contribuyente = AE.id_contribuyente
			INNER JOIN inspectores IPT ON IPT.id_inspector = IPC.id_inspector
			INNER JOIN distritos DI ON DI.id_distrito = AE.id_distrito
			INNER JOIN rubros RU ON RU.id_rubro = AE.id_rubro
			INNER JOIN gestiones GE ON GE.id_gestion = AE.id_gestion
			WHERE IPC.fecha_asignacion BETWEEN $P{desde} AND $P{hasta} 
			$P!{condicion}
			ORDER BY IPT.nombre ASC]]>
	</queryString>
	<field name="gestion" class="java.lang.String"/>
	<field name="nombre_comercial" class="java.lang.String"/>
	<field name="rubro" class="java.lang.String"/>
	<field name="distrito" class="java.lang.String"/>
