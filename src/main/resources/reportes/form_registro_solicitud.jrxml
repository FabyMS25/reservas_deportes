		<defaultValueExpression><![CDATA[" IS NOT NULL "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CO.nro_carnet || ' ' || CO.extension || ' ' || CO.expedido AS carnet,
			CO.nombre || ' ' || CO.ap_paterno || ' ' || CO.ap_materno AS contribuyente,
			CO.tipo_contribuyente, CO.tipo_documento, CO.fecha_nacimiento, 
			AE.nro_act_economica, AE.nombre_comercial, AE.tipo_actividad, AE.superficie,
			AE.bloque, AE.edificio, AE.planta, AE.dep_of_loc, AE.direccion,
			DI.distrito, ZT.zona, LI.cod_licencia, LI.fecha_emision, LI.tipo_licencia
			FROM contribuyentes CO
			INNER JOIN actividades_economicas AE ON AE.id_contribuyente = CO.id_contribuyente
			INNER JOIN rubros RU ON RU.id_rubro = AE.id_rubro
			INNER JOIN distritos DI ON DI.id_distrito = AE.id_distrito
			INNER JOIN licencias LI ON LI.id_actividad = AE.id_actividad
			INNER JOIN zonas_tributarias ZT ON ZT.id_zona = LI.id_zona
			WHERE CO.nro_carnet = $P{nroCarnet}]]>
	</queryString>
