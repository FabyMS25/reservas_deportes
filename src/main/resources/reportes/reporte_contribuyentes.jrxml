	<queryString>
		<![CDATA[SELECT CO.nro_carnet || ' ' || CO.extension || ' ' || CO.expedido AS carnet, 
			CO.fecha_nacimiento, CO.nit, CO.razon_social, 
			CO.nombre || ' ' || CO.ap_paterno || ' ' || CO.ap_materno AS contribuyente,
			CO.tipo_contribuyente, AE.nro_act_economica, AE.nombre_comercial, 
			CO.celular, CO.email, CO.direccion
			FROM contribuyentes CO
			LEFT JOIN actividades_economicas AE ON AE.id_contribuyente = CO.id_contribuyente
			WHERE $P!{condicion}]]>
	</queryString>
