<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ReporteGeneralMensualidades"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="43e31a55-4c7c-4e8c-8016-e0d018088079">

	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="reservas"/>

	<parameter name="fechaini" class="java.util.Date"/>
	<parameter name="fechafin" class="java.util.Date"/>
	<parameter name="estado" class="java.lang.String"/>
	<parameter name="escuelita" class="java.lang.String"/>
	<parameter name="logo64" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>

	<queryString><![CDATA[
WITH detalle AS (
    SELECT
        RE.uuid::text AS reserva_uuid,
        RE.fecha_reserva::date AS fecha_reserva,
        RE.numero_reserva,
        RE.numero_tasa,
        RE.estado_reserva,
        RE.monto_total::double precision AS monto_total,
        RE.es_reserva_gratuita,
        RE.motivo_gratuidad,

        (CON.nombre || ' ' ||
         COALESCE(CON.primer_apellido, '') || ' ' ||
         COALESCE(CON.segundo_apellido, '')) AS contribuyente,

        CON.numero_documento AS ci,
        ORG.nombre AS escuela,
        RP.entrenador,
        RP.disciplina,
        RP.matricula,
        RP.mes,
        RP.año AS gestion,
        EST.nombre_completo AS estudiante,

        COM.nombre AS complejo,
        CA.nombre AS campo_deportivo,
        (COM.nombre || ' / ' || CA.nombre) AS complejo_campo,

        ROW_NUMBER() OVER (
            PARTITION BY RE.id_reserva
            ORDER BY RP.año, RP.mes, EST.nombre_completo, RP.matricula
        ) AS fila_reserva

    FROM reservas RE
    JOIN reservas_periodo RP
        ON RP.id_reserva = RE.id_reserva
    JOIN campos_deportivos CA
        ON CA.id_campo = RE.id_campo
    JOIN complejos_deportivos COM
        ON COM.id_complejo = CA.id_complejo
    JOIN contribuyentes CON
        ON CON.id_contribuyente = RE.id_contribuyente
    JOIN inscripciones_escuela ES
        ON ES.id_inscripcion = RP.id_inscripcion_escuela
    JOIN estudiantes EST
        ON EST.id_estudiante = ES.id_estudiante
    JOIN organizaciones ORG
        ON ORG.id_organizacion = RE.id_organizacion

    WHERE RE.fecha_reserva::date BETWEEN $P{fechaini} AND $P{fechafin}
      AND RE.estado = false
      AND RE.tipo_reserva = 'periodo'
      AND ORG.nombre LIKE $P{escuelita}
      AND RE.estado_reserva LIKE $P{estado}
)
SELECT
    reserva_uuid,
    fecha_reserva,
    numero_reserva,
    numero_tasa,
    estado_reserva,
    monto_total,
    CASE
        WHEN fila_reserva = 1 THEN monto_total
        ELSE 0::double precision
    END AS monto_contable,
    es_reserva_gratuita,
    motivo_gratuidad,
    contribuyente,
    ci,
    escuela,
    entrenador,
    disciplina,
    matricula,
    mes,
    gestion,
    estudiante,
    complejo,
    campo_deportivo,
    complejo_campo
FROM detalle
ORDER BY
    escuela,
    fecha_reserva,
    numero_reserva,
    gestion,
    mes,
    estudiante
    ]]></queryString>

