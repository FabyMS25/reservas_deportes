	<field name="nro_carnet" class="java.lang.String"/>
	<field name="com" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="estado_reserva" class="java.lang.String"/>
	<field name="uuidR" class="java.lang.String"/>
