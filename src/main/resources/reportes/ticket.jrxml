	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="deportes"/>
	<parameter name="logo64" class="java.lang.String">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="uuid" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[Select  reservas.uuid as uuidR,categoria,fecha_created,fecha_reserva,hora_entrada,estado_reserva,
		hora_salida,numero_tasa, total_pago, codigo, tipo,	complejo.nombre as com,descripcion, 
		ap_paterno, ap_materno,nro_carnet,
		(CON.nombre||' '||CON.ap_paterno||' '||CON.ap_materno) AS contri
		from reservas
		join canchas on canchas.id_cancha = reservas.id_cancha
		join complejo on complejo.id_complejo =  canchas.id_complejo
		join superficie on superficie.id_superficie = canchas.id_superficie
		join contribuyentes AS CON on CON.id_contribuyente = reservas.id_contribuyente
		where reservas.uuid=$P{uuid}]]>
	</queryString>
	<field name="categoria" class="java.lang.String"/>
	<field name="fecha_created" class="java.sql.Date"/>
	<field name="fecha_reserva" class="java.sql.Date"/>
	<field name="hora_entrada" class="java.sql.Time"/>
	<field name="hora_salida" class="java.sql.Time"/>
	<field name="numero_tasa" class="java.lang.String"/>
	<field name="total_pago" class="java.lang.Double"/>
	<field name="contri" class="java.lang.String"/>
	<field name="ap_paterno" class="java.lang.String"/>
