<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reservas" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a77dc372-66dd-4299-907b-ca1368cc0224">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="reservas"/>
	<parameter name="fecha_ini" class="java.sql.Date"/>
	<parameter name="fecha_fin" class="java.sql.Date"/>
	<parameter name="logo64" class="java.lang.String">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[
SELECT PA.uuid,
       PA.folio,
       PA.entidad_financiera,
       PA.fecha_pago,
       PA.forma_pago,
       PA.monto_pagado,
       PA.numero_tasa AS tasa,
       COM.nombre AS tt,
       SU.descripcion,
       CON.nombre || ' ' || CON.primer_apellido || ' ' || CON.segundo_apellido AS contri
FROM pagos AS PA
JOIN reservas AS RE
  ON RE.id_reserva = PA.id_reserva
JOIN campos_deportivos AS ca
  ON ca.id_campo = RE.id_campo
JOIN contribuyentes AS CON
  ON CON.id_contribuyente = RE.id_contribuyente
JOIN complejos_deportivos AS COM
  ON COM.id_complejo = ca.id_complejo
JOIN superficies AS SU
  ON SU.id_superficie = ca.id_superficie
WHERE PA.fecha_pago BETWEEN $P{fecha_ini} AND $P{fecha_fin}
  AND PA.estado = false
  AND RE.estado = false
ORDER BY PA.fecha_pago ASC
    ]]>
	</queryString>
	<field name="uuid" class="java.lang.String"/>
	<field name="folio" class="java.lang.String"/>
	<field name="fecha_pago" class="java.sql.Date"/>
	<field name="monto_pagado" class="java.lang.Double"/>
	<field name="tasa" class="java.lang.String"/>
	<field name="contri" class="java.lang.String"/>
	<field name="tt" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
