	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="deportes"/>
	<parameter name="fecha_ini" class="java.sql.Date"/>
	<parameter name="fecha_fin" class="java.sql.Date"/>
	<parameter name="logo64" class="java.lang.String">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="uuid" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select PA.uuid, PA.folio, PA.entidad_financiera, PA.fecha_pago, PA.forma_pago,
		PA.monto_pagado as monto_pago, PA.numero_tasa as tasa, COMP.nombre as tt, SU.descripcion,
		(CON.nombre || ' ' || CON.primer_apellido || ' ' || CON.segundo_apellido) AS contri
		from pagos as PA
		join reservas as RE on RE.id_reserva = PA.id_reserva
		join contribuyentes as CON on CON.id_contribuyente = RE.id_contribuyente
		join campos_deportivos as CA on CA.id_campo = RE.id_campo
		join complejos_deportivos as COMP on COMP.id_complejo = CA.id_complejo
		join superficies as SU on SU.id_superficie = CA.id_superficie
		where PA.uuid = $P{uuid}]]>
	</queryString>
	<field name="uuid" class="java.lang.String"/>
	<field name="folio" class="java.lang.String"/>
	<field name="fecha_pago" class="java.sql.Date"/>
	<field name="monto_pago" class="java.lang.Double"/>
	<field name="tasa" class="java.lang.String"/>
	<field name="contri" class="java.lang.String"/>
	<field name="tt" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="forma_pago" class="java.lang.String"/>
