	<queryString>
		<![CDATA[SELECT BA.nro_baja, BA.fecha_baja, BA.nota_respaldo, 
			BA.motivo_baja, BA.solicitante, LI.cod_licencia, 
			LI.fecha_emision, LI.estado_licencia, AE.nombre_comercial
			FROM bajas BA
			INNER JOIN licencias LI ON LI.id_licencia = BA.id_licencia
			INNER JOIN actividades_economicas AE ON AE.id_actividad = LI.id_actividad
			WHERE BA.fecha_baja BETWEEN $P{desde} AND $P{hasta} $P!{condicion}]]>
	</queryString>
