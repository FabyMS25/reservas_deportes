	</parameter>
	<queryString>
		<![CDATA[SELECT FL.nro_registro, FL.fecha_registro, FL.fecha_defuncion, 
			concat(FL.nombre, ' ', FL.ap_paterno, ' ', FL.ap_materno) AS difunto,
			FL.sexo, FL.ciudad_origen, FL.observacion, 
			FM.nombre AS familiar, FM.nro_carnet,
			FM.email, FM.celular, FM.direccion, 
			TU.codigo AS codigo_nicho, TU.tipo_tumba, TU.fecha_inicio, TU.fecha_fin,
			BL.nombre_bloque, BL.tipo_bloque,
			SC.codigo_sector, SC.nombre_sector
			FROM fallecidos FL
			LEFT JOIN familiares FM ON FM.id_familiar = FL.id_familiar
			LEFT JOIN tumbas TU ON TU.id_tumba = FL.id_tumba
			LEFT JOIN bloques BL ON BL.id_bloque = TU.id_bloque
			LEFT JOIN sectores SC ON SC.id_sector = BL.id_sector
			WHERE FL.estado = false AND FL.uuid = $P{fallecidoUuid}]]>
	</queryString>
	<field name="familiar" class="java.lang.String"/>
	<field name="difunto" class="java.lang.String"/>
	<field name="codigo_nicho" class="java.lang.String"/>
