	<queryString>
		<![CDATA[SELECT CO.nro_carnet || ' ' || CO.expedido AS carnet, 
			CO.nombre || ' ' || CO.ap_paterno || ' ' || CO.ap_materno AS contribuyente,
			CO.tipo_contribuyente, AE.nro_act_economica, AE.nombre_comercial, 
			AE.direccion, LI.cod_licencia, LI.tipo_licencia, 
			LI.fecha_inicio, LI.fecha_vencimiento
			FROM licencias LI
			INNER JOIN actividades_economicas AE ON AE.id_actividad = LI.id_actividad
			INNER JOIN contribuyentes CO ON CO.id_contribuyente = AE.id_contribuyente
			WHERE LI.fecha_vencimiento BETWEEN '2023-09-01' AND '2023-10-30']]>
	</queryString>
