	<parameter name="uuidActEconomica" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CO.nro_carnet || ' ' || CO.extension || ' ' || CO.expedido AS carnet,
			CO.nombre || ' ' || CO.ap_paterno || ' ' || CO.ap_materno AS contribuyente,
			CO.tipo_contribuyente, AE.nro_act_economica, 
			AE.nombre_comercial, AE.tipo_actividad, AE.superficie,
			AE.direccion, DI.distrito, LI.cod_licencia, LI.fecha_emision
			FROM actividades_economicas AE
			INNER JOIN licencias LI ON LI.id_actividad = AE.id_actividad
			INNER JOIN contribuyentes CO ON CO.id_contribuyente = AE.id_contribuyente 
			INNER JOIN rubros RU ON RU.id_rubro = AE.id_rubro
			INNER JOIN distritos DI ON DI.id_distrito = AE.id_distrito
			WHERE AE.uuid = $P{uuidActEconomica}]]>
	</queryString>
	<field name="carnet" class="java.lang.String"/>
	<field name="contribuyente" class="java.lang.String"/>
	<field name="nro_act_economica" class="java.lang.String"/>
	<field name="nombre_comercial" class="java.lang.String"/>
