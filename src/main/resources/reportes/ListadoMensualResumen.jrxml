	<parameter name="fecha_ini" class="java.sql.Date"/>
	<parameter name="fecha_fin" class="java.sql.Date"/>
	<parameter name="estado" class="java.lang.String"/>
	<parameter name="logo64" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="escuela" class="java.lang.String"/>
	<parameter name="contribuyente" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    RE.numero_reserva,
    RE.fecha_reserva,

    CONCAT_WS(
        ' ',
        CON.nombre,
        CON.primer_apellido,
        CON.segundo_apellido
    ) AS contri,

    ORG.nombre AS escuela,

    COM.nombre AS complejo,
    CA.nombre AS cancha,

    (
        SELECT RP.disciplina
        FROM reservas_periodo AS RP
        WHERE RP.id_reserva = RE.id_reserva
        LIMIT 1
    ) AS disciplina,

    RE.numero_tasa,
    P.estado_pago,
    P.fecha_pago,
    P.monto_pagado,
    RE.monto_total

FROM reservas AS RE

JOIN pagos AS P
    ON P.id_reserva = RE.id_reserva
    AND P.estado = false

JOIN campos_deportivos AS CA
    ON CA.id_campo = RE.id_campo

JOIN complejos_deportivos AS COM
    ON COM.id_complejo = CA.id_complejo

JOIN contribuyentes AS CON
    ON CON.id_contribuyente = RE.id_contribuyente

JOIN organizaciones AS ORG
    ON ORG.id_organizacion = RE.id_organizacion

WHERE RE.tipo_reserva = 'periodo'
  AND RE.estado = false
  AND RE.fecha_reserva BETWEEN $P{fecha_ini} AND $P{fecha_fin}
  AND ORG.nombre LIKE $P{escuela}
  AND P.estado_pago LIKE $P{estado}
  AND CONCAT_WS(
        ' ',
        CON.nombre,
        CON.primer_apellido,
        CON.segundo_apellido
      ) LIKE $P{contribuyente}

ORDER BY
    ORG.nombre,
    RE.fecha_reserva,
    RE.numero_reserva]]>
	</queryString>
