	<queryString>
		<![CDATA[SELECT AE.nro_act_economica, GE.gestion,
			CO.nombre || ' ' || CO.ap_paterno || ' ' || CO.ap_materno AS contribuyente,
			AE.nombre_comercial, AE.tipo_actividad, AE.superficie,
			RU.rubro, DI.codigo, DI.distrito, AE.direccion
			FROM actividades_economicas AE
			INNER JOIN contribuyentes CO ON CO.id_contribuyente = AE.id_contribuyente
			INNER JOIN distritos DI ON DI.id_distrito = AE.id_distrito
			INNER JOIN rubros RU ON RU.id_rubro = AE.id_rubro
			INNER JOIN gestiones GE ON GE.id_gestion = AE.id_gestion
			WHERE $P!{condicion}]]>
	</queryString>
