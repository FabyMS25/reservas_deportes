<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reservas" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a77dc372-66dd-4299-907b-ca1368cc0224">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="reservas"/>
	<parameter name="logo64" class="java.lang.String">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="uuid" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select  RE.uuid,tipo_reserva,rp.categoria,re.fecha_creacion,fecha_reserva,fecha_uso,hora_inicio,estado_reserva, telefono_principal as tel,
		hora_fin,numero_tasa, monto_total, numero_reserva, codigo, tipo_reserva, (COM.nombre||' '||ca.nombre) as comp, TA.descripcion, TA.precio_base, 
		RP.cantidad_personas as per,	(CON.nombre||' '||CON.primer_apellido||' '||CON.segundo_apellido) AS contri, 
		con.numero_documento as ci, Com.nombre as cancha,ubicacion, RP.mes
		from reservas as RE
		join campos_deportivos as ca on ca.id_campo = re.id_campo
		join complejos_deportivos as COM on com.id_complejo=ca.id_complejo
		join contribuyentes AS CON on CON.id_contribuyente = re.id_contribuyente
		join reservas_puntuales as RP on rp.id_reserva = re.id_reserva 
		join tarifas as TA on Ta.id_tarifa= re.id_tarifa
		where RE.uuid=$P{uuid}]]>
	</queryString>
