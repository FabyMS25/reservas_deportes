<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
			  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
			  name="ticketmensual"
			  pageWidth="612" pageHeight="792"
			  columnWidth="555"
			  leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="reservas"/>
	<property name="net.sf.jasperreports.print.order.preserve" value="true"/>

	<parameter name="logo64" class="java.lang.String">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="uuid" class="java.lang.String"/>
	<parameter name="detalle_tarifario" class="java.lang.String"/>

	<queryString language="SQL">
		<![CDATA[
        select RE.uuid,
               tipo_reserva,
               re.fecha_creacion,
               fecha_reserva,
               estado_reserva,
               telefono_principal as tel,
               numero_tasa,
               monto_total,
               CAST(
                   monto_total / NULLIF(COUNT(*) OVER (PARTITION BY RE.id_reserva), 0)
                   AS double precision
               ) AS monto_detalle,
               numero_reserva,
               codigo,
               tipo_reserva,
               COM.nombre as comp,
               CA.nombre as cancha,
               ubicacion,
               (CON.nombre || ' ' || CON.primer_apellido || ' ' || CON.segundo_apellido) AS contri,
               con.numero_documento as ci,
               ES.nombre_completo as estu,
               RP.mes,
               RP.año as gestion,
               RP.disciplina,
               RP.entrenador,
               RP.matricula,
               ORG.nombre as escuela
        from reservas as RE
        join reservas_periodo as RP on RP.id_reserva = RE.id_reserva
        join campos_deportivos as CA on CA.id_campo = RE.id_campo
        join complejos_deportivos as COM on COM.id_complejo = CA.id_complejo
        join contribuyentes AS CON on CON.id_contribuyente = RE.id_contribuyente
        left join estudiantes_escuela as ES on ES.id_estudiante = RP.id_estudiante_escuela
        left join organizaciones as ORG on ORG.id_organizacion = RE.id_organizacion
        where RE.uuid = $P{uuid} and RE.estado = false
        order by ES.nombre_completo, RP.año, RP.mes
        ]]>
	</queryString>

	<field name="uuid" class="java.lang.String"/>
	<field name="tipo_reserva" class="java.lang.String"/>
	<field name="fecha_creacion" class="java.sql.Timestamp"/>
	<field name="fecha_reserva" class="java.sql.Date"/>
	<field name="estado_reserva" class="java.lang.String"/>
	<field name="tel" class="java.lang.String"/>
	<field name="numero_tasa" class="java.lang.String"/>
	<field name="monto_total" class="java.lang.Double"/>
	<field name="monto_detalle" class="java.lang.Double"/>
	<field name="numero_reserva" class="java.lang.String"/>
	<field name="codigo" class="java.lang.String"/>
	<field name="comp" class="java.lang.String"/>
	<field name="cancha" class="java.lang.String"/>
	<field name="ubicacion" class="java.lang.String"/>
	<field name="contri" class="java.lang.String"/>
	<field name="ci" class="java.lang.String"/>
	<field name="estu" class="java.lang.String"/>
	<field name="mes" class="java.lang.Integer"/>
	<field name="gestion" class="java.lang.Integer"/>
	<field name="disciplina" class="java.lang.String"/>
	<field name="entrenador" class="java.lang.String"/>
	<field name="matricula" class="java.lang.String"/>
	<field name="escuela" class="java.lang.String"/>

	<background>
		<band splitType="Stretch"/>
	</background>

	<title>
		<band height="110" splitType="Stretch">
			<image scaleImage="FillFrame" onErrorType="Blank">
				<reportElement x="2" y="10" width="120" height="45"/>
				<imageExpression><![CDATA[
                    net.sf.jasperreports.engine.util.JRImageLoader.getInstance(
                        new net.sf.jasperreports.engine.SimpleJasperReportsContext()
                    ).loadAwtImageFromBytes(
                        java.util.Base64.getDecoder().decode($P{logo64})
                    )
                ]]></imageExpression>
			</image>

			<staticText>
				<reportElement x="125" y="5" width="405" height="20"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="13" isBold="true"/>
				</textElement>
				<text><![CDATA[GOBIERNO AUTÓNOMO MUNICIPAL DE QUILLACOLLO]]></text>
			</staticText>

			<staticText>
				<reportElement x="125" y="25" width="405" height="18"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[SECRETARÍA MUNICIPAL DE DESARROLLO INTEGRAL - UNIDAD DE DEPORTES]]></text>
			</staticText>

			<line>
				<reportElement x="125" y="40" width="405" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Solid"/>
				</graphicElement>
			</line>

			<staticText>
				<reportElement x="125" y="45" width="405" height="16"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9"/>
				</textElement>
				<text><![CDATA[SISTEMA DE GESTIÓN DE RESERVAS DE CAMPOS DEPORTIVOS]]></text>
			</staticText>

			<staticText>
				<reportElement x="0" y="70" width="555" height="22"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[TICKET DE MENSUALIDAD - ESCUELA MUNICIPAL]]></text>
			</staticText>

			<line>
				<reportElement x="120" y="92" width="315" height="1"/>
				<graphicElement>
					<pen lineWidth="1.0" lineStyle="Solid"/>
				</graphicElement>
			</line>
		</band>
	</title>

	<pageHeader>
		<band height="25" splitType="Stretch">
			<line>
				<reportElement x="0" y="0" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Solid"/>
				</graphicElement>
			</line>

			<staticText>
				<reportElement x="0" y="5" width="95" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Autorización N°:]]></text>
			</staticText>

			<textField isBlankWhenNull="true">
				<reportElement x="95" y="5" width="140" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    $F{numero_reserva} == null || $F{numero_reserva}.trim().isEmpty() ? "N/A" : $F{numero_reserva}
                ]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="330" y="5" width="90" height="14"/>
				<textElement textAlignment="Right">
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<text><![CDATA[Quillacollo, ]]></text>
			</staticText>

			<textField pattern="EEEE, d 'de' MMMM 'de' yyyy">
				<reportElement x="420" y="5" width="150" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>

			<line>
				<reportElement x="0" y="20" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Solid"/>
				</graphicElement>
			</line>
		</band>
	</pageHeader>

	<columnHeader>
		<band height="130" splitType="Stretch">
			<!-- BLOQUE DATOS DEL SOLICITANTE -->
			<rectangle radius="3">
				<reportElement x="0" y="0" width="555" height="60" backcolor="#F8F9FA"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Solid" lineColor="#CCCCCC"/>
				</graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="8" y="6" width="80" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[SOLICITANTE:]]></text>
			</staticText>

			<textField isBlankWhenNull="true">
				<reportElement x="92" y="6" width="250" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    $F{contri} == null ? "-" : $F{contri}
                ]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="350" y="6" width="45" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[CI/NIT:]]></text>
			</staticText>

			<textField isBlankWhenNull="true">
				<reportElement x="402" y="6" width="142" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    $F{ci} == null ? "-" : $F{ci}
                ]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="8" y="24" width="80" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[CEL. REF.:]]></text>
			</staticText>

			<textField isBlankWhenNull="true">
				<reportElement x="92" y="24" width="250" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    $F{tel} == null || $F{tel}.trim().isEmpty() ? "-" : $F{tel}
                ]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="350" y="24" width="50" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[TASA N°:]]></text>
			</staticText>

			<textField isBlankWhenNull="true">
				<reportElement x="402" y="24" width="142" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    $F{numero_tasa} == null || $F{numero_tasa}.trim().isEmpty() ? "-" : $F{numero_tasa}
                ]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="8" y="42" width="160" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[LUGAR Y FECHA DE RESERVA:]]></text>
			</staticText>

			<textField pattern="dd/MM/yyyy">
				<reportElement x="170" y="42" width="300" height="14"/>
				<textElement>
					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    "Quillacollo, " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_reserva})
                ]]></textFieldExpression>
			</textField>

			<!-- TEXTO LEGAL -->
			<staticText>
				<reportElement x="0" y="64" width="550" height="14"/>
				<textElement textAlignment="Justified">
					<font fontName="SansSerif" size="9" isItalic="true"/>
				</textElement>
				<text><![CDATA[En beneficio del deporte boliviano y amparados bajo la Ley Nacional del Deporte N° 804, artículos 3, 4, 5 y 51.]]></text>
			</staticText>

			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="77" width="550" height="28"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="SansSerif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[
                    "Tengo a bien autorizar el pago de mensualidad de la escuela municipal <b>" +
                    ($F{escuela} == null ? "-" : $F{escuela}) +
                    "</b>, correspondiente a los estudiantes y períodos detallados a continuación, para el escenario deportivo <b>" +
                    ($F{comp} == null ? "" : $F{comp}) + " - " +
                    ($F{cancha} == null ? "" : $F{cancha}) +
                    "</b>."
                ]]></textFieldExpression>
			</textField>

			<!-- CABECERA TABLA -->
			<rectangle radius="3">
				<reportElement x="0" y="108" width="555" height="22" backcolor="#D9E5F2"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Solid" lineColor="#AFC0D0"/>
				</graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="1" y="114" width="118" height="14"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[ESTUDIANTE]]></text>
			</staticText>

			<staticText>
				<reportElement x="121" y="114" width="80" height="14"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[MATRÍCULA]]></text>
			</staticText>

			<staticText>
				<reportElement x="203" y="114" width="125" height="14"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[DISCIPLINA / ENTRENADOR]]></text>
			</staticText>

			<staticText>
				<reportElement x="330" y="114" width="80" height="14"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[PERÍODO]]></text>
			</staticText>

			<staticText>
				<reportElement x="412" y="114" width="70" height="14"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[MENSUALIDAD]]></text>
			</staticText>

			<staticText>
				<reportElement x="484" y="114" width="70" height="14"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[ESTADO]]></text>
			</staticText>

		</band>
	</columnHeader>

	<detail>
		<band height="30" splitType="Prevent">
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="1" y="2" width="118" height="26" stretchType="RelativeToTallestObject"/>
				<textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{estu} == null ? "-" : $F{estu}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="121" y="2" width="80" height="26" stretchType="RelativeToTallestObject"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{matricula} == null || $F{matricula}.trim().isEmpty() ? "-" : $F{matricula}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="203" y="2" width="125" height="26" stretchType="RelativeToTallestObject"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="html"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[
					"<b>" + ($F{disciplina} == null ? "-" : $F{disciplina}) + "</b><br/>" +
					"<span style='font-size:8px;'>Prof.: " + ($F{entrenador} == null ? "-" : $F{entrenador}) + "</span>"
				]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="330" y="2" width="80" height="26" stretchType="RelativeToTallestObject"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[
					($F{mes} == null ? "-" : new java.text.DateFormatSymbols(new java.util.Locale("es", "BO")).getMonths()[$F{mes} - 1])
					+ " " + ($F{gestion} == null ? "" : String.valueOf($F{gestion}))
				]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="412" y="2" width="70" height="26" stretchType="RelativeToTallestObject"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[
					$F{monto_detalle} == null ? "0.00 Bs." :
					($F{monto_detalle}.doubleValue() == 0.0 ? "GRATUITA" : String.format(java.util.Locale.US, "%.2f Bs.", $F{monto_detalle}))
				]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="484" y="2" width="70" height="26" stretchType="RelativeToTallestObject"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{estado_reserva} == null ? "-" : $F{estado_reserva}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="29" width="555" height="1" positionType="Float"/>
				<graphicElement><pen lineWidth="0.25" lineColor="#D9D9D9"/></graphicElement>
			</line>
		</band>
	</detail>

	<pageFooter>
		<band height="15" splitType="Stretch">
			<line>
				<reportElement x="0" y="0" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.25" lineStyle="Solid"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="0" y="3" width="555" height="12"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="7" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Documento generado electrónicamente - Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<summary>
		<band height="195" splitType="Stretch">
			<rectangle radius="3">
				<reportElement x="0" y="5" width="555" height="28" backcolor="#F8F9FA"/>
				<graphicElement><pen lineWidth="0.5" lineColor="#D9D9D9"/></graphicElement>
			</rectangle>
			<textField isBlankWhenNull="true">
				<reportElement x="10" y="12" width="145" height="14"/>
				<textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[($F{escuela} == null ? "-" : $F{escuela}) + ":"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="155" y="12" width="285" height="14"/>
				<textElement><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[
					($F{comp} == null ? "-" : $F{comp}) + " - " + ($F{cancha} == null ? "-" : $F{cancha})
				]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="440" y="12" width="55" height="14"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
				<text><![CDATA[TOTAL:]]></text>
			</staticText>
			<textField>
				<reportElement x="497" y="12" width="55" height="14"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[
					$F{monto_total} == null ? "0.00" : String.format(java.util.Locale.US, "%.2f", $F{monto_total})
				]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="0" y="42" width="555" height="12" positionType="Float"/>
				<textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
				<text><![CDATA[DETALLE TARIFARIO]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="0" y="58" width="555" height="32" positionType="Float"/>
				<textElement><font fontName="SansSerif" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{detalle_tarifario}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="0" y="98" width="555" height="28" positionType="Float"/>
				<textElement textAlignment="Justified"><font fontName="SansSerif" size="9"/></textElement>
				<text><![CDATA[Este documento acredita el registro de las mensualidades detalladas para la escuela municipal dentro del Sistema de Gestión de Reservas de Campos Deportivos del Gobierno Autónomo Municipal de Quillacollo.]]></text>
			</staticText>

			<line><reportElement x="40" y="155" width="200" height="1" positionType="Float"/></line>
			<line><reportElement x="315" y="155" width="200" height="1" positionType="Float"/></line>
			<staticText>
				<reportElement x="40" y="159" width="200" height="14" positionType="Float"/>
				<textElement textAlignment="Center"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
				<text><![CDATA[RESPONSABLE DE DEPORTES]]></text>
			</staticText>
			<staticText>
				<reportElement x="315" y="159" width="200" height="14" positionType="Float"/>
				<textElement textAlignment="Center"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
				<text><![CDATA[CONTRIBUYENTE]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="315" y="175" width="200" height="14" positionType="Float"/>
				<textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{contri}]]></textFieldExpression>
			</textField>
		</band>
	</summary>

</jasperReport>
