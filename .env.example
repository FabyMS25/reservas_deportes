# Use KEY=value syntax. Single-quote secrets containing $ or #.

SPRING_DATASOURCE_URL=jdbc:postgresql://181.177.143.187:5433/db_deportes
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

USUARIOS_GATEWAY_BASE_URL=http://181.177.143.185:8080/api
RUAT_BE_GATEWAY_BASE_URL=http://181.177.143.187:8090/api/ruat
RUAT_BE_GATEWAY_API_KEY=

APP_PUBLIC_BASE_URL:http=//localhost:4200
APP_CORS_ALLOWED_ORIGINS=https://deportes.quillacollo.gob.bo
APP_CODE=SIS-013
APP_NAME=DEPORTESAPP
APLICATION_ADMIN_MENU=Administracion

# current production signing secret.
DEPORTES_JWT_SECRET=
DEPORTES_TOKEN_EXPIRATION_SECONDS=28800
EXTERNAL_CLIENT_CONNECT_TIMEOUT=10s
EXTERNAL_CLIENT_READ_TIMEOUT=180s
EXTERNAL_HTTP_LOG_LEVEL=INFO

# Optional pgAdmin account; separate from PostgreSQL credentials.
# Set both before `docker compose --profile admin up -d`.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Uncomment to include pgAdmin in every normal `docker compose up -d`.
# COMPOSE_PROFILES=admin
