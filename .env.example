SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

RUAT_GATEWAY_BASE_URL=http://181.177.143.187:8090/api/ruat
USUARIOS_GATEWAY_BASE_URL=http://181.177.143.185:8080/api
RUAT_GATEWAY_INTERNAL_API_KEY=

APPLICATION_CODE=SIS-013
APPLICATION_NAME=DEPORTESAPP
APLICATION_ADMIN_MENU=Administracion
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://deportes.quillacollo.gob.bo

# current production signing secret.
DEPORTES_JWT_SECRET=
