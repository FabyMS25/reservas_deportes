	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="reservas"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="fechaini" class="java.sql.Date"/>
	<parameter name="fechafin" class="java.sql.Date"/>
	<parameter name="tipocobro" class="java.lang.String"/>
	<parameter name="estado" class="java.lang.String"/>
	<parameter name="logo64" class="java.lang.String">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="cancha" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  RE.uuid,tipo_reserva,rp.categoria,re.fecha_creacion,fecha_reserva,  fecha_aprobacion,rp.fecha_inicio, estado_reserva, telefono_principal as tel,
		Rp.fecha_fin,numero_tasa, monto_total, RE.es_reserva_gratuita, RE.motivo_gratuidad, numero_reserva, codigo, tipo_reserva, (COM.nombre||' '||ca.nombre) as comp, TA.descripcion, TA.precio_base,
		TA.tipo_cobro , estado_reserva,	RP.cantidad_personas as per, horario_fijo,	
		(CON.nombre||' '||CON.primer_apellido||' '||CON.segundo_apellido) AS contri, con.numero_documento as ci, Com.nombre as cancha,ubicacion
		from reservas as RE
		join campos_deportivos as ca on ca.id_campo = re.id_campo
		join complejos_deportivos as COM on com.id_complejo=ca.id_complejo
		join contribuyentes AS CON on CON.id_contribuyente = re.id_contribuyente
		join reservas_recurrentes as RP on rp.id_reserva = re.id_reserva 
		join tablero as tab on tab.id_tablero = rp.id_tablero
		join tarifas as TA on Ta.id_tarifa= re.id_tarifa
		where fecha_reserva between $P{fechaini} and $P{fechafin}
		and RE.estado = false
		and TA.tipo_cobro LIKE $P{tipocobro} 
		and estado_reserva like $P{estado}
		and  COM.nombre like  $P{cancha}]]>
	</queryString>
