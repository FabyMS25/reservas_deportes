	<parameter name="fechaini" class="java.sql.Date"/>
	<parameter name="fechafin" class="java.sql.Date"/>
	<parameter name="estado" class="java.lang.String"/>
	<parameter name="logo64" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="]]></defaultValueExpression>
	</parameter>
	<parameter name="escuelita" class="java.lang.String"/>
	<queryString>
		<![CDATA[select RE.uuid,fecha_reserva,tipo_reserva,estado_reserva, telefono_principal as tel,
		numero_tasa, monto_total, RE.es_reserva_gratuita, RE.motivo_gratuidad, numero_reserva, codigo, tipo_reserva, (COM.nombre||' '||ca.nombre) as comp,  
		(CON.nombre||' '||CON.primer_apellido||' '||CON.segundo_apellido) AS contri, 
		con.numero_documento as ci, Com.nombre as cancha,ubicacion, ES.nombre_completo as estu,
		RP.mes, RP.año as gestion, RP.disciplina, RP.Entrenador, RP.matricula, ORG.nombre as escuela
		from reservas as RE
		join reservas_periodo as RP on rp.id_reserva = re.id_reserva
		join campos_deportivos as ca on ca.id_campo = re.id_campo
		join complejos_deportivos as COM on com.id_complejo=ca.id_complejo
		join contribuyentes AS CON on CON.id_contribuyente = re.id_contribuyente
		join estudiantes_escuela as ES on ES.id_estudiante = RP.id_estudiante_escuela
		join organizaciones as ORG on org.id_organizacion = re.id_organizacion
		WHERE RE.fecha_reserva BETWEEN $P{fechaini} AND $P{fechafin}
		AND RE.estado = false
		AND ORG.nombre LIKE  $P{escuelita} and RE.estado is false
		AND RE.estado_reserva LIKE $P{estado}]]>
	</queryString>
